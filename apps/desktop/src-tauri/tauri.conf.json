{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IndioTube",
  "version": "0.1.44",
  "identifier": "com.indiotube.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IndioTube",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "backgroundColor": "#0f0f0f",
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-smooth-scrolling"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "../vendor/ytdlp/yt-dlp.exe",
      "../vendor/ffmpeg/ffmpeg.exe",
      "../vendor/ffmpeg/ffprobe.exe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

{
  "name": "indiotube-desktop",
  "private": true,
  "version": "0.1.40",
  "description": "IndioTube — ad-free YouTube desktop player with phone sync (Tauri + Rust).",
  "author": "IndioTube",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:rust": "node ../../scripts/with-rust-env.js cargo test --manifest-path rust/indio-core/Cargo.toml && node ../../scripts/with-rust-env.js cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "node ../../scripts/dev.js",
    "tauri:shell": "node ../../scripts/with-rust-env.js tauri dev",
    "tauri:build": "node ../../scripts/fetch-ytdlp.js && node ../../scripts/fetch-ffmpeg.js && node ../../scripts/with-rust-env.js tauri build",
    "dist": "npm run tauri:build"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "@tauri-apps/api": "^2"
  }
}

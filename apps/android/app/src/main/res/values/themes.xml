<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this base theme just keeps the system
         chrome (status bar, window background) dark from the first frame. -->
    <style name="Theme.IndioTube" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0F0F0F</item>
        <item name="android:statusBarColor">#0F0F0F</item>
        <item name="android:navigationBarColor">#0F0F0F</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
